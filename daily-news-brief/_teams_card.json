            "facts": [
              {
                "title": "1. House Oversight hearing today on ATF out-of-business records",
                "value": "Heat 82 ▲"
              },
              {
                "title": "2. SCOTUS declines Maryland sensitive-places case (Novotny)",
                "value": "Heat 81 ▼"
              },
              {
                "title": "3. Ohio SB 214 (suppressors, SBRs) still awaits governor",
                "value": "Heat 80 ▶"
